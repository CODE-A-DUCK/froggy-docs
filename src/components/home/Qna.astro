---
interface Props {
  title?: string;
}

const { title = "一些常見問題" } = Astro.props;
---

<div
  class="max-w-4xl mx-auto flex flex-col items-center justify-center px-4 md:px-0 mb-32 mt-12"
>
  {
    title && (
      <h2 class="text-4xl md:text-5xl font-black text-center text-white mb-4">
        {title}
      </h2>
    )
  }
  <div class="w-full flex flex-col gap-2" id="faqContainer">
    <slot />
  </div>
</div>
