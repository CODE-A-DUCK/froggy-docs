---
// src/components/ReviewCard.astro
interface Props {
  name?: string;
  avatar?: string;
  userId?: string;
  rating?: number;
}

const {
  name: defaultName = "Unknown User",
  avatar: defaultAvatar = "https://cdn.discordapp.com/embed/avatars/0.png",
  userId,
  rating = 5,
} = Astro.props;

let finalName = defaultName;
let finalAvatar = defaultAvatar;

if (userId) {
  try {
    const token = import.meta.env.DISCORD_TOKEN;
    if (token) {
      const res = await fetch(`https://discord.com/api/v10/users/${userId}`, {
        headers: {
          Authorization: `Bot ${token}`,
        },
      });
      if (res.ok) {
        const data = await res.json();
        finalName = data.global_name || data.username || defaultName;
        if (data.avatar) {
          finalAvatar = `https://cdn.discordapp.com/avatars/${userId}/${data.avatar}.png?size=128`;
        } else {
          const defaultAvatarIndex = parseInt(data.discriminator || "0") % 5;
          finalAvatar = `https://cdn.discordapp.com/embed/avatars/${defaultAvatarIndex}.png`;
        }
      }
    } else {
      console.warn("找不到 DISCORD_TOKEN，將使用預設的使用者名稱與頭像。");
    }
  } catch (e) {
    console.error(`無法獲取 Discord 用戶 ${userId} 的資料:`, e);
  }
}

const safeRating = Math.max(0, Math.min(5, Math.floor(rating)));
const filledStars = "★".repeat(safeRating);
const emptyStars = "★".repeat(5 - safeRating);
---

<div class="testimonial-card">
  <blockquote class="testimonial-body">
    <slot />
  </blockquote>

  <div class="testimonial-author">
    <img
      src={finalAvatar}
      alt={finalName}
      class="testimonial-avatar"
      loading="lazy"
    />
    <div class="author-details">
      <span class="author-name">{finalName}</span>
      <div class="stars" aria-label={`Rating: ${safeRating} out of 5 stars`}>
        <span class="star-filled">{filledStars}</span><span class="star-empty"
          >{emptyStars}</span
        >
      </div>
    </div>
  </div>
</div>

<style>
  .testimonial-card {
    display: flex;
    flex-direction: column;
    height: auto;
    margin: 0 !important;
    padding: 1rem 0;
    background: transparent;
  }

  .testimonial-body {
    margin: 0 0 1.5rem 0;
    padding-left: 1.25rem;
    border-left: 2px solid #5c6a82;
    color: #9ca3af;
    font-size: 1rem;
    line-height: 1.6;
    flex-grow: 1;
  }

  .testimonial-body :global(p) {
    margin: 0;
  }

  .testimonial-author {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .testimonial-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    background-color: #1e1f22;
  }

  .author-details {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    color: #f3f4f6;
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.2;
  }

  :global([data-theme="light"]) .author-name {
    color: #1e1f22 !important;
  }

  .stars {
    margin-top: 4px;
    font-size: 16px;
    line-height: 1;
    letter-spacing: 2px;
  }

  .star-filled {
    color: #f59e0b;
  }

  .star-empty {
    color: rgba(128, 128, 128, 0.2);
  }
</style>
